# ─── Server Configuration ─────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── MongoDB Database ─────────────────────────────────────────────────────────
# Replace with your MongoDB connection string (e.g. MongoDB Atlas or local)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/learneo?retryWrites=true&w=majority

# ─── JWT Authentication ───────────────────────────────────────────────────────
# Secret key used for signing JWT tokens (use a random string >= 32 characters)
JWT_SECRET=your_jwt_secret_key_min_32_characters_here

# ─── Google Gemini AI ─────────────────────────────────────────────────────────
# Get your API key from https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_DAILY_LIMIT=100

# ─── Adaptive Learning Engine Parameters ──────────────────────────────────────
# Mastery exponential moving average weight (0 < alpha <= 1)
MASTERY_ALPHA=0.3
# Minimum interaction attempts before determining mastery status
MIN_ATTEMPTS=3
# Number of recent attempts evaluated for learning trend slope
TREND_WINDOW=3
# Minimum positive slope required to consider learner improving
TREND_SLOPE_THRESHOLD=0.10

# ─── CORS & Frontend URLs ─────────────────────────────────────────────────────
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000,https://your-frontend.vercel.app
# Base URL of frontend used for generating Room QR codes
FRONTEND_URL=http://localhost:3000
